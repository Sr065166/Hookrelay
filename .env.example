# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# NOTE: Use port 5433 if you have a local PostgreSQL installation on 5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/hookrelay

# Database Container Defaults (for docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=hookrelay
POSTGRES_PORT=5433

# Client URL (CORS)
CLIENT_URL=http://localhost:5173

# JWT Secrets (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_ACCESS_SECRET=change_me_min_64_chars_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JWT_REFRESH_SECRET=change_me_min_64_chars_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
